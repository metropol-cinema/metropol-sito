# Read-API della programmazione (gestionale metropol-cinema)
PROGRAMMAZIONE_API_URL=https://app.cinemametropol.it/api/public/programmazione
# Token dedicato ai consumer di lettura (= PROGRAMMAZIONE_READ_TOKEN del gestionale). SOLO server-side.
PROGRAMMAZIONE_API_TOKEN=

# TMDB: backdrop orizzontali per gli hero e poster ottimizzati. Opzionale:
# senza chiave il sito usa le locandine data-URI di Cinebot.
TMDB_API_KEY=

# Deep-link di acquisto biglietti (piattaforma vendita online Cinebot,
# campo "URL vendita online" in Opzioni → Web Service).
# {eventId} = id evento (sourceId) della proiezione; {titolo} = titolo in slug.
# Finché è vuota, i bottoni "Acquista" non compaiono.
TICKET_URL_TEMPLATE=https://ticket.cinebot.it/metropol/{eventId}/{titolo}

# Google Analytics 4: ID di misurazione del tag (G-XXXXXXXXXX), NON il numero
# di proprieta' usato dal gestionale per leggere i dati (GA4_PROPERTY_ID).
# Si trova in GA4 -> Amministrazione -> Flussi di dati -> il flusso del sito.
# Finche' e' vuota non parte nessuno script e il banner cookie non compare.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
